{
    "name": "voltcms/mcp",
    "description": "Drop-in MCP server and OAuth 2.1 authorization server for flat-file PHP applications — no identity provider, no database, no daemon.",
    "type": "library",
    "keywords": ["mcp", "model-context-protocol", "oauth2", "oauth2.1", "pkce", "flat-file", "voltcms"],
    "homepage": "https://github.com/voltcms/mcp",
    "license": "MIT",
    "authors": [
        {
            "name": "Jannis Rondorf",
            "email": "github@jrondorf.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "league/oauth2-server": "^9.4",
        "mcp/sdk": "0.8.*",
        "voltcms/useraccess": "^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "nyholm/psr7": "A PSR-17 factory implementation, required by the HTTP transport (recommended).",
        "nyholm/psr7-server": "Builds a PSR-7 server request from superglobals, for applications without a framework."
    },
    "autoload": {
        "psr-4": {
            "VoltCMS\\MCP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VoltCMS\\MCP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
